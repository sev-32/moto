{
  "name": "lucid-moto",
  "version": "2.0.0-dev",
  "private": true,
  "description": "LUCID MOTO - hyper-real Ducati 916 motorcycle simulation (consolidated build system).",
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "build:legacy": "node tools/build.mjs --target legacy --verify",
    "build:reference": "node tools/build-reference.mjs --all --verify",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:browser": "node tests/browser/smoke.mjs"
  },
  "engines": { "node": ">=20" }
}
